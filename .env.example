# Copie este archivo como .env y complete los valores. Nunca suba el .env al repositorio.

# Puerto de la API REST y de WebSockets
PORT=5000

# Persistencia: "mongo" (requiere MONGODB_URI) o "memoria" (sin base de datos)
PERSISTENCIA=mongo
MONGODB_URI=

# Secreto para firmar los tokens de sesión (cadena larga y aleatoria)
JWT_SECRET=
JWT_EXPIRACION=8h

# Secreto compartido con la pasarela para firmar el webhook (HMAC-SHA256)
WEBHOOK_SECRET=

# Orígenes del frontend autorizados (separados por coma)
CORS_ORIGENES=http://localhost:4200

# true = crea usuarios y subastas de demostración al iniciar (si no existen)
SEMBRAR_DEMO=false

# Simulador de la pasarela (npm run pasarela)
PASARELA_PUERTO=5050
PASARELA_API_URL=http://localhost:5000/api/v1
